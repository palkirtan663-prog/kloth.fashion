{
  "framework": "vite",
  "installCommand": "npm --prefix urbanthread-ai/client install",
  "buildCommand": "npm --prefix urbanthread-ai/client run build",
  "outputDirectory": "urbanthread-ai/client/dist",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}

