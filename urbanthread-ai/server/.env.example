# ========================================================
# Kloth.fashion / UrbanThread Server Environment Variables
# ========================================================

# Port for the Express server to listen on (default: 5000)
PORT=5000

# Allowed client origin(s) for CORS, comma-separated
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# MongoDB Connection String (MongoDB Atlas mongodb+srv:// or local mongodb://)
# If unavailable or connection fails, localStore resilience is automatically activated!
MONGODB_URI=mongodb+srv://pbabal118_db_user:AgwiEfJOT1P0onMZ@cluster0.rmxwyny.mongodb.net/Kloth

# Secret key used for signing JWT authentication tokens (min 32 chars)
JWT_SECRET=0ca4125f6cfdedcca6b76b7f84bf308e372db93ec80354b1f1887b75940c7712273ccf55fe41f59fe2f188cb169679dd
JWT_EXPIRES_IN=2h

# Initial admin bootstrap credentials
ADMIN_EMAIL=admin@urbanthread.com
ADMIN_PASSWORD=UrbanThread@2026!

# Automatically seed initial catalogue products if empty
AUTO_SEED_PRODUCTS=true

# Optional AI Stylist Assistant (OpenAI-compatible)
# Leave empty for smart scripted demo mode (works without any key)
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=15000

