{
  "name": "urbanthread-server",
  "version": "1.0.0",
  "private": true,
  "description": "Kloth.fashion API (Express + MongoDB + JWT)",

  "main": "src/server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "seed": "node src/seed/seedProducts.js",
    "seed:reset": "node src/seed/seedProducts.js --reset",
    "seed:admin": "node src/seed/seedAdmin.js",
    "admin:reset": "node src/seed/setAdminPassword.js",
    "migrate:users": "node src/seed/importLegacyUsers.js",
    "test": "node --test"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.0"
  }
}
